def stress(a):
    v1 = a + 1
    v2 = a + 2
    v3 = a + 3
    v4 = a + 4
    v5 = a + 5
    v6 = a + 6
    v7 = a + 7
    v8 = a + 8
    v9 = a + 9
    v10 = a + 10
    v11 = a + 11
    v12 = a + 12
    return v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12


def stressf(a):
    v1 = a + 1.5
    v2 = a + 2.5
    v3 = a + 3.5
    v4 = a + 4.5
    v5 = a + 5.5
    v6 = a + 6.5
    v7 = a + 7.5
    v8 = a + 8.5
    v9 = a + 9.5
    v10 = a + 10.5
    v11 = a + 11.5
    v12 = a + 12.5
    return v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12


print(stress(100))
print(stressf(100.0))
