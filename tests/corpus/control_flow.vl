def f(n):
    total = 0
    for i in range(n):
        if i % 3 == 0:
            continue
        if i > 12:
            break
        total += i
    return total


print(f(20))


def g():
    c = 0
    a = 0
    while a < 5:
        b = 0
        while b < 5:
            if b == 2:
                break
            c += 1
            b += 1
        a += 1
    return c


print(g())


def h(n):
    s = 0
    i = 0
    while i < n:
        i += 1
        if i % 2 == 0:
            continue
        s += i
    return s


print(h(100))
